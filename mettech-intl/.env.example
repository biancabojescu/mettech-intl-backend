# Copy to .env beside pom.xml and fill in your own values.
# Keep values unquoted: Spring imports this file as Java properties.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/mettech_intl
SPRING_DATASOURCE_USERNAME=YOUR_DATABASE_USER
SPRING_DATASOURCE_PASSWORD=YOUR_DATABASE_PASSWORD
JWT_ALGORITHM_KEY=REPLACE_WITH_A_LONG_RANDOM_SIGNING_SECRET
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=false
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=false
EMAIL_FROM=no-reply@example.com
APP_FRONTEND_URL=http://localhost:4200
# Maven does not import .env; export SONAR_TOKEN separately when running the scanner.
SONAR_TOKEN=
